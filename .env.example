# .env にコピーして値を入れる（.env は Git 管理外）
# Open WebUI の管理者 API キー（管理画面 General で API Keys を有効化 → Settings > Account > API Keys で発行）
OPENWEBUI_API_KEY=
# llm01 上で実行するときは既定値のままでよい
OPENWEBUI_URL=http://localhost:3000
# トークン数の計測に使う llama-swap（空海AI用エントリ）
LLAMA_SWAP_URL=http://localhost:8080
LLAMA_SWAP_MODEL=kukai
